<Window x:Class="ConsultationLedger.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:ConsultationLedger.ViewModels"
        mc:Ignorable="d"
        Title="ConsultationHub - 일일 상담 관리 장부" 
        Icon="../app_icon.ico"
        Height="840" Width="1380"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header & KPI Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP HEADER & KPI SUMMARY BAR -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- App Title Branding -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" Background="{StaticResource PrimaryBrush}" CornerRadius="8" Margin="0,0,10,0">
                        <TextBlock Text="📋" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="ConsultationHub" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="일일 상담 관리 장부 v1.0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- KPI Cards -->
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Today Count -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="오늘 진행 상담" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding TodayCount}" Style="{StaticResource KpiValueText}" />
                            <TextBlock Text=" 건" FontSize="14" VerticalAlignment="Bottom" Margin="4,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Month Count -->
                <Border Grid.Column="1" Style="{StaticResource CardPanel}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="이번 달 총 상담" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding MonthCount}" Style="{StaticResource KpiValueText}" Foreground="#2563EB" />
                            <TextBlock Text=" 건" FontSize="14" VerticalAlignment="Bottom" Margin="4,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Pending Follow-ups -->
                <Border Grid.Column="2" Style="{StaticResource CardPanel}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="팔로우업/재상담 예정" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding PendingFollowUpCount}" Style="{StaticResource KpiValueText}" Foreground="#D97706" />
                            <TextBlock Text=" 건" FontSize="14" VerticalAlignment="Bottom" Margin="4,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Total Count -->
                <Border Grid.Column="3" Style="{StaticResource CardPanel}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="누적 데이터" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding TotalCount}" Style="{StaticResource KpiValueText}" Foreground="#10B981" />
                            <TextBlock Text=" 건" FontSize="14" VerticalAlignment="Bottom" Margin="4,0,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left: Search & Filter Panel -->
                <ColumnDefinition Width="250" />
                <!-- Center: Edit & Detail Form Panel (상담 작성 및 편집 - 중앙 배치) -->
                <ColumnDefinition Width="*" />
                <!-- Right: Consultation DataGrid List -->
                <ColumnDefinition Width="520" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: SEARCH & FILTER SIDEBAR -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="🔍 검색 및 필터" Style="{StaticResource SectionHeader}" />

                        <!-- Keyword Search Input -->
                        <TextBlock Text="통합 검색 (고객명/연락처/내용/태그)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                        <!-- Category Filter -->
                        <TextBlock Text="상담 카테고리" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategoryFilter}" Padding="8,6" Margin="0,0,0,14" />

                        <!-- Status Filter -->
                        <TextBlock Text="진행 상태" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatusFilter}" Padding="8,6" Margin="0,0,0,14" />

                        <!-- Date Range Picker -->
                        <TextBlock Text="조회 시작일" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}" />
                        <DatePicker SelectedDate="{Binding StartDateFilter}" Padding="6" Margin="0,0,0,10" />

                        <TextBlock Text="조회 종료일" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}" />
                        <DatePicker SelectedDate="{Binding EndDateFilter}" Padding="6" Margin="0,0,0,16" />

                        <!-- Action Buttons -->
                        <Button Content="필터 초기화" Command="{Binding ResetFilterCommand}" Style="{StaticResource OutlineButton}" Margin="0,0,0,8" HorizontalAlignment="Stretch" />
                        <Button Content="📊 CSV 파일 내보내기" Command="{Binding ExportCsvCommand}" Style="{StaticResource OutlineButton}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CENTER: EDIT & FORM PANEL (상담 상세 및 작성 폼 - 스크롤 없이 한 화면 최적화) -->
            <Border Grid.Column="1" Style="{StaticResource CardPanel}" Margin="0,0,12,0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Row 0: Form Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Customer Info Card (한 줄 통합: 연락처*, 고객명, 주소*) -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Metadata (카테고리, 상태, 우선순위, 상담일시, 재상담일) -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 3: Summary & Tags (상담 요약 * + 소형 태그) -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 4: Details Label -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 5: Details TextArea (남은 높이 전체 채움) -->
                        <RowDefinition Height="*" />
                        <!-- Row 6: Form Buttons (항상 하단 고정 노출) -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Form Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="📝 상담 작성 및 상세 내용" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" Margin="0" />
                        <Button Content="+ 신규 작성" Command="{Binding NewRecordCommand}" Style="{StaticResource OutlineButton}" HorizontalAlignment="Right" Padding="10,3" />
                    </DockPanel>

                    <!-- PROMINENT CUSTOMER INFO SECTION (한 줄 초슬림 통합) -->
                    <Border Grid.Row="1" Background="#F3F4F6" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="👤 고객 인적사항" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4" />
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="135" /> <!-- 연락처 * -->
                                    <ColumnDefinition Width="110" /> <!-- 고객명 (선택) -->
                                    <ColumnDefinition Width="*" />   <!-- 주소 * -->
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="연락처 (전화번호) *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding EditRecord.ClientPhone, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnCustomerInfoInputChanged" FontWeight="Bold" Background="White" Padding="6,4" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock Text="고객명 (선택)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding EditRecord.ClientName, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnCustomerInfoInputChanged" Background="White" Padding="6,4" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="주소 (소재지/배송지) *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding EditRecord.Address, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnCustomerInfoInputChanged" FontWeight="Bold" Background="White" Padding="6,4" />
                                </StackPanel>
                            </Grid>

                            <!-- SUBTLE AUTOMATIC HINT BANNER -->
                            <Border Visibility="{Binding HasExistingCustomerMatch, Converter={StaticResource BoolToVis}}" 
                                    Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,6,0,0">
                                <DockPanel>
                                    <TextBlock Text="{Binding ExistingMatchMessage}" FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <Button Content="기존정보 채우기" Command="{Binding FillExistingCustomerCommand}" Style="{StaticResource ModernButton}" Background="#2563EB" FontSize="11" Padding="6,2" Margin="0,0,4,0" />
                                        <Button Content="이력 보기" Command="{Binding FilterHistoryForMatchedCustomerCommand}" Style="{StaticResource OutlineButton}" FontSize="11" Padding="6,2" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- METADATA 5 COLUMNS ROW -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="1.15*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="카테고리" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <ComboBox ItemsSource="{Binding EditCategories}" SelectedItem="{Binding EditRecord.Category}" Padding="4,4" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="2,0,4,0">
                            <TextBlock Text="진행 상태" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <ComboBox ItemsSource="{Binding EditStatuses}" SelectedItem="{Binding EditRecord.Status}" Padding="4,4" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="2,0,4,0">
                            <TextBlock Text="우선순위" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding EditRecord.Priority}" Padding="4,4" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="2,0,4,0">
                            <TextBlock Text="상담 일시" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <DatePicker SelectedDate="{Binding EditRecord.ConsultationDate}" Padding="4,3" />
                        </StackPanel>

                        <StackPanel Grid.Column="4" Margin="2,0,0,0">
                            <TextBlock Text="재상담 예정일" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <DatePicker SelectedDate="{Binding EditRecord.FollowUpDate}" Padding="4,3" />
                        </StackPanel>
                    </Grid>

                    <!-- SUMMARY & TAGS ROW -->
                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="상담 요약 (한 줄 정리) *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                            <TextBox Text="{Binding EditRecord.Summary, UpdateSourceTrigger=PropertyChanged}" 
                                     FontSize="{Binding WritingFontSize}" 
                                     PreviewMouseWheel="OnWritingTextBoxPreviewMouseWheel" 
                                     Padding="6,4" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="태그 (선택)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <TextBox Text="{Binding EditRecord.Tags, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                        </StackPanel>
                    </Grid>

                    <!-- DETAILS HEADER WITH FONT SIZE CONTROLS -->
                    <DockPanel Grid.Row="4" Margin="0,0,0,4">
                        <TextBlock Text="상세 상담 내용" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        
                        <!-- Font Size Toolbar -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="글자 크기:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Content="A-" Command="{Binding DecreaseFontSizeCommand}" Style="{StaticResource OutlineButton}" 
                                    Padding="5,0" Height="20" MinWidth="24" FontSize="10" ToolTip="글자 크기 축소 (Ctrl + 마우스 휠 아래)" Margin="0,0,2,0" />
                            <ComboBox ItemsSource="{Binding AvailableFontSizes}" SelectedItem="{Binding WritingFontSize}" 
                                      ItemStringFormat="{}{0}pt" Width="58" Height="20" Padding="3,0" FontSize="11" VerticalContentAlignment="Center" ToolTip="작성 글자 크기 선택" Margin="0,0,2,0" />
                            <Button Content="A+" Command="{Binding IncreaseFontSizeCommand}" Style="{StaticResource OutlineButton}" 
                                    Padding="5,0" Height="20" MinWidth="24" FontSize="10" ToolTip="글자 크기 확대 (Ctrl + 마우스 휠 위)" Margin="0,0,2,0" />
                            <Button Content="초기화" Command="{Binding ResetFontSizeCommand}" Style="{StaticResource OutlineButton}" 
                                    Padding="5,0" Height="20" FontSize="10" ToolTip="기본 크기(14pt)로 재설정" />
                        </StackPanel>
                    </DockPanel>

                    <!-- DETAILS TEXTBOX (남은 높이 자동 채움) -->
                    <TextBox Grid.Row="5" 
                             x:Name="DetailsTextBox"
                             Text="{Binding EditRecord.Details, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="{Binding WritingFontSize}"
                             PreviewMouseWheel="OnWritingTextBoxPreviewMouseWheel"
                             TextWrapping="Wrap" 
                             AcceptsReturn="True" 
                             VerticalScrollBarVisibility="Auto" 
                             MinHeight="60"
                             Margin="0,0,0,10" />

                    <!-- FORM BUTTONS (하단 고정) -->
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="💾 상담 내용 저장하기" Command="{Binding SaveRecordCommand}" Style="{StaticResource ModernButton}" Padding="0,8" Margin="0,0,6,0" />
                        <Button Grid.Column="1" Content="신규 작성" Command="{Binding NewRecordCommand}" Style="{StaticResource OutlineButton}" Padding="12,8" Margin="0,0,6,0" />
                        <Button Grid.Column="2" Content="🗑 삭제" Command="{Binding DeleteRecordCommand}" Style="{StaticResource DangerButton}" Padding="12,8" />
                    </Grid>
                </Grid>
            </Border>

            <!-- RIGHT: CONSULTATION DATAGRID LIST -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="📋 상담 기록 목록" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" Margin="0"/>
                        <Border Background="#EEF2FF" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}">
                                <Run Text="전체 " /><Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text="건" />
                            </TextBlock>
                        </Border>
                    </DockPanel>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding Records}" 
                              SelectedItem="{Binding SelectedRecord}"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              HeadersVisibility="Column"
                              Background="White"
                              RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No" Binding="{Binding RowIndex}" Width="35" />
                            <DataGridTextColumn Header="고객명" Binding="{Binding DisplayClientName}" Width="75" FontWeight="Bold" />
                            <DataGridTextColumn Header="연락처" Binding="{Binding ClientPhone}" Width="105" />
                            <DataGridTextColumn Header="주소" Binding="{Binding Address}" Width="130" />
                            <DataGridTextColumn Header="상담일시" Binding="{Binding FormattedDate}" Width="100" />
                            <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="55" />
                            <DataGridTextColumn Header="상담 요약" Binding="{Binding Summary}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <StatusBar Grid.Row="2" Background="Transparent" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
