<Window x:Class="ConsultationLedger.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:ConsultationLedger.ViewModels"
        xmlns:converters="clr-namespace:ConsultationLedger.Converters"
        mc:Ignorable="d"
        Title="ConsultationHub - 스마트 고객 상담 관리 장부" 
        Icon="../app_icon.ico"
        Height="890" Width="1440"
        MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        AllowDrop="True"
        PreviewDragEnter="OnWindowPreviewDragEnter"
        PreviewDragOver="OnWindowPreviewDragOver"
        PreviewDragLeave="OnWindowPreviewDragLeave"
        PreviewDrop="OnWindowPreviewDrop">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:ImagePathToBitmapConverter x:Key="ImagePathToBitmap" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveRecordCommand}" />
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewRecordCommand}" />
        <KeyBinding Modifiers="Control" Key="F" Command="{Binding ClearSearchCommand}" />
    </Window.InputBindings>

    <Grid Margin="14,10,14,8">
        <Grid.RowDefinitions>
            <!-- Row 0: Ultra-Slim Brand Header & Compact KPI Bar (~36px) -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Main Two-Column Workspace (Master-Detail with Splitter) -->
            <RowDefinition Height="*" />
            <!-- Row 2: Status Bar & Shortcut Guide (~22px) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================================================= -->
        <!-- TOP HEADER: ULTRA-SLIM BRANDING & COMPACT KPI BAR       -->
        <!-- ======================================================= -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- App Logo & Title (Slim) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="30" Height="30" Background="{StaticResource PrimaryBrush}" CornerRadius="8" Margin="0,0,8,0">
                    <TextBlock Text="📋" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Consultation" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Hub" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                        <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v2.2" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Compact KPI Badges Bar (슬림 가로 배치) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <!-- Today -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="9,3" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="오늘 " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TodayCount}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="건" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Month Total -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="9,3" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="이번달 " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding MonthCount}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InfoBrush}"/>
                        <TextBlock Text="건" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Pending Follow-ups -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="9,3" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="재상담 예정 " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding PendingFollowUpCount}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock Text="건" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Total Count -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="9,3">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="누적 보관 " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalCount}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock Text="건" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Top Right Action Toolbar -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="📊 엑셀(CSV) 내보내기" Command="{Binding ExportCsvCommand}" Style="{StaticResource OutlineButton}" Padding="10,5" Margin="0,0,6,0" ToolTip="현재 목록을 엑셀 호환 CSV 파일로 저장합니다." />
                <Button Content="🔄 새로고침" Command="{Binding SearchCommand}" Style="{StaticResource OutlineButton}" Padding="8,5" ToolTip="목록과 통계를 새로고침합니다 (F5)" />
            </StackPanel>
        </Grid>

        <!-- ============================================================== -->
        <!-- MAIN TWO-COLUMN SPLIT WORKSPACE WITH DRAGGABLE SPLITTER       -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left: Master Consultation List & Smart Filter (드래그 조절 가능) -->
                <ColumnDefinition x:Name="LeftColumn" Width="520" MinWidth="220" MaxWidth="850" />
                <!-- Center: Interactive GridSplitter Column (마우스 드래그 구분선) -->
                <ColumnDefinition x:Name="SplitterColumn" Width="10" />
                <!-- Right: Consultation Detail & Smart Editor (Flex *, 광활한 작성 공간) -->
                <ColumnDefinition x:Name="RightColumn" Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- ============================================== -->
            <!-- LEFT COLUMN: MASTER CONSULTATION LIST PANE     -->
            <!-- ============================================== -->
            <Border x:Name="MasterListBorder" Grid.Column="0" Style="{StaticResource CardPanel}" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Row 0: Search Input Box -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Quick Filter Chips Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Sub-filter & Record Count Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 3: Modern DataGrid List -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search Input Box (with Clear button) -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" 
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="28,6,6,6" 
                                 FontSize="12" 
                                 ToolTip="단축키: Ctrl + F (주소, 고객명, 연락처, 내용 등 통합 검색)" />
                        <!-- Watermark Placeholder when SearchText is empty -->
                        <TextBlock Text="주소(동/호수/건물명), 고객명, 연락처 검색..." 
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" 
                                   VerticalAlignment="Center" Margin="28,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Magnifier Icon Overlay -->
                        <TextBlock Text="🔍" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" 
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" />
                        <!-- Clear Search Button -->
                        <Button Grid.Column="1" Content="✕" Command="{Binding ClearSearchCommand}" 
                                Style="{StaticResource OutlineButton}" Width="28" Height="28" Margin="4,0,0,0" 
                                Padding="0" ToolTip="검색어 지우기" />
                    </Grid>

                    <!-- Quick Filter Chips Bar (원클릭 필터 칩) -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <!-- All -->
                            <Button Content="전체" Command="{Binding SetQuickFilterCommand}" CommandParameter="전체" 
                                    Margin="0,0,3,0" Padding="10,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Today -->
                            <Button Content="오늘" Command="{Binding SetQuickFilterCommand}" CommandParameter="오늘" 
                                    Margin="0,0,3,0" Padding="10,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterToday}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- In Progress -->
                            <Button Content="진행중" Command="{Binding SetQuickFilterCommand}" CommandParameter="진행중" 
                                    Margin="0,0,3,0" Padding="10,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterProgress}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Follow-up Needed -->
                            <Button Content="재상담 예정" Command="{Binding SetQuickFilterCommand}" CommandParameter="재상담 예정" 
                                    Margin="0,0,3,0" Padding="10,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterFollowUp}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Completed -->
                            <Button Content="완료" Command="{Binding SetQuickFilterCommand}" CommandParameter="완료" 
                                    Margin="0,0,3,0" Padding="10,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterCompleted}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Urgent -->
                            <Button Content="긴급" Command="{Binding SetQuickFilterCommand}" CommandParameter="긴급" 
                                    Margin="0,0,0,0" Padding="10,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterUrgent}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sub-filter Toolbar (Category Dropdown + Count Indicator) -->
                    <DockPanel Grid.Row="2" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="카테고리:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategoryFilter}" 
                                      FontSize="11" Padding="5,2" Height="24" VerticalContentAlignment="Center" Width="95" Margin="0,0,6,0" />
                            <Button Content="초기화" Command="{Binding ResetFilterCommand}" Style="{StaticResource OutlineButton}" 
                                    FontSize="10" Padding="5,2" Height="24" ToolTip="모든 검색어 및 필터 조건을 초기화합니다." />
                        </StackPanel>

                        <!-- Count Badge -->
                        <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="10" Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}">
                                <Run Text="조회 " /><Run Text="{Binding Records.Count, Mode=OneWay}" /><Run Text="건" />
                            </TextBlock>
                        </Border>
                    </DockPanel>

                    <!-- Modern DataGrid List -->
                    <DataGrid Grid.Row="3" 
                              ItemsSource="{Binding Records}" 
                              SelectedItem="{Binding SelectedRecord}"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              HeadersVisibility="Column"
                              RowHeight="38">
                        <DataGrid.Columns>
                            <!-- Index Column -->
                            <DataGridTextColumn Header="No" Binding="{Binding RowIndex}" Width="32">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter Property="FontSize" Value="10" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Modern Status Pill Badge -->
                            <DataGridTemplateColumn Header="상태" Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBgColor}" CornerRadius="10" Padding="5,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusFgColor}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Address Column (가장 중요한 주소를 최우선 전면 배치) -->
                            <DataGridTextColumn Header="주소 (소재지/배송지)" Binding="{Binding DisplayAddress}" Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Address}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Customer Name -->
                            <DataGridTextColumn Header="고객명" Binding="{Binding DisplayClientName}" Width="65">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Phone -->
                            <DataGridTextColumn Header="연락처" Binding="{Binding ClientPhone}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Date (MM-dd HH:mm) -->
                            <DataGridTextColumn Header="일시" Binding="{Binding ShortDate}" Width="68">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontSize" Value="10" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Photo Indicator Column -->
                            <DataGridTemplateColumn Header="📷" Width="30">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="📷" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding HasImages, Converter={StaticResource BoolToVis}}"
                                                   ToolTip="{Binding ImageCount, StringFormat='첨부 사진 {0}장'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Summary -->
                            <DataGridTextColumn Header="상담 요약" Binding="{Binding Summary}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        <Setter Property="FontSize" Value="11" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ============================================================== -->
            <!-- CENTER: DRAGGABLE GRIDSPLITTER (마우스 드래그 좌우 비율 조절)   -->
            <!-- ============================================================== -->
            <GridSplitter x:Name="MainSplitter" 
                          Grid.Column="1" 
                          Width="10" 
                          HorizontalAlignment="Stretch" 
                          VerticalAlignment="Stretch" 
                          Background="Transparent" 
                          Cursor="SizeWE" 
                          ShowsPreview="False" 
                          ResizeDirection="Columns" 
                          ResizeBehavior="PreviousAndNext"
                          MouseDoubleClick="OnSplitterDoubleClicked">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent" SnapsToDevicePixels="True" ToolTip="마우스 드래그로 좌우 너비 조절 (더블클릭 시 기본 너비 복원)">
                            <!-- Center Grip Handle -->
                            <Border x:Name="GripBar" Width="4" Height="48" CornerRadius="2" 
                                    Background="{StaticResource BorderDarkBrush}" 
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GripBar" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="GripBar" Property="Width" Value="6" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="GripBar" Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
                                <Setter TargetName="GripBar" Property="Width" Value="6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- ================================================================ -->
            <!-- RIGHT COLUMN: DETAIL & SMART EDITOR (TEXT-FIRST EXPANSION)       -->
            <!-- ================================================================ -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Row 0: Canvas Header (Mode Indicator + Collapse Button + New Record Button) - ~26px -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Ultra-Slim Customer Info Bar (1줄 통합) - ~32px -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Customer Duplicate Match Hint (Collapsed when empty) - Auto -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 3: Ultra-Slim Metadata & Quick Follow-Up Bar (1줄 통합) - ~32px -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 4: Summary & Tags (1줄 통합) - ~32px -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 5: Details Header & Font Toolbar - ~24px -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 6: Details TextArea (남은 전체 높이 70%+ 완벽 장악!) - Height="*" -->
                        <RowDefinition Height="*" />
                        <!-- Row 7: Attached Images Bar & Thumbnail Gallery - Auto -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 8: Bottom Action Bar - ~38px -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Drag & Drop Dropzone Banner Overlay -->
                    <Border Visibility="{Binding IsDragOverActive, Converter={StaticResource BoolToVis}}"
                            Background="#F04F46E5" CornerRadius="12" Padding="28,18"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Panel.ZIndex="999"
                            Grid.Row="0" Grid.RowSpan="9" IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.35" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📥" FontSize="34" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="마우스를 놓으면 사진이 바로 첨부됩니다" FontSize="16" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="JPG, PNG, BMP, GIF, WEBP 지원 (다중 파일 가능)" FontSize="12" Foreground="#C7D2FE" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ROW 0: CANVAS HEADER (모드 표시 + 목록 접기 토글 + 신규 작성 버튼) -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Toggle Master List Button (전체화면 작성 모드 토글) -->
                            <Button x:Name="ToggleCollapseButton" 
                                    Content="◀ 목록 접기" 
                                    Click="OnToggleCollapseMasterListClicked" 
                                    Style="{StaticResource MiniToolButton}" 
                                    FontSize="10" Padding="6,2" Margin="0,0,8,0" 
                                    ToolTip="왼쪽 상담 목록을 접어 상담 작성 공간을 전체화면으로 넓힙니다 (단축키: F11)" />

                            <TextBlock Text="{Binding EditModeTitle}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Visibility="{Binding IsEditingNew, Converter={StaticResource BoolToVis}}" 
                                    Background="{StaticResource PrimarySoftBrush}" CornerRadius="5" Padding="5,1" Margin="8,0,0,0">
                                <TextBlock Text="신규 작성" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                            </Border>
                        </StackPanel>

                        <!-- Fast New Record Button -->
                        <Button Content="+ 새 상담 작성 (Ctrl+N)" Command="{Binding NewRecordCommand}" Style="{StaticResource OutlineButton}" 
                                HorizontalAlignment="Right" Padding="10,3" FontSize="11" FontWeight="SemiBold" ToolTip="새로운 상담 작성 모드로 전환합니다." />
                    </DockPanel>

                    <!-- ROW 1: ULTRA-SLIM CUSTOMER INFO BAR (초슬림 1줄 가로 배치) -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Address* (가장 중요한 주소를 맨 앞 첫 번째, 가장 넓은 영역에 배치) -->
                                <ColumnDefinition Width="*" />
                                <!-- Name -->
                                <ColumnDefinition Width="135" />
                                <!-- Phone* -->
                                <ColumnDefinition Width="195" />
                            </Grid.ColumnDefinitions>

                            <!-- Address Field with Copy (맨 앞 1번째 배치) -->
                            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="🏠 주소*" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <Button DockPanel.Dock="Right" Content="📋" Command="{Binding CopyAddressCommand}" Style="{StaticResource MiniToolButton}" 
                                        Width="24" Height="24" Padding="0" Margin="3,0,0,0" ToolTip="주소 복사" />
                                <TextBox Text="{Binding EditRecord.Address, UpdateSourceTrigger=PropertyChanged}" 
                                         TextChanged="OnCustomerInfoInputChanged" 
                                         FontWeight="Bold" FontSize="12" Padding="6,3" Height="26" VerticalContentAlignment="Center"
                                         ToolTip="고객 주소 (소재지/배송지/건물명/호수 등) - 필수" />
                            </DockPanel>

                            <!-- Customer Name (2번째 배치) -->
                            <DockPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="고객명" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox Text="{Binding EditRecord.ClientName, UpdateSourceTrigger=PropertyChanged}" 
                                         TextChanged="OnCustomerInfoInputChanged" 
                                         FontSize="12" Padding="6,3" Height="26" VerticalContentAlignment="Center"
                                         ToolTip="고객 성함 (선택)" />
                            </DockPanel>

                            <!-- Phone Field with Copy (3번째 배치) -->
                            <DockPanel Grid.Column="2">
                                <TextBlock Text="연락처*" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <Button DockPanel.Dock="Right" Content="📋" Command="{Binding CopyPhoneCommand}" Style="{StaticResource MiniToolButton}" 
                                        Width="24" Height="24" Padding="0" Margin="3,0,0,0" ToolTip="연락처 복사" />
                                <TextBox x:Name="PhoneTextBox" 
                                         Text="{Binding EditRecord.ClientPhone, UpdateSourceTrigger=PropertyChanged}" 
                                         TextChanged="OnCustomerInfoInputChanged" 
                                         LostFocus="OnPhoneTextBoxLostFocus"
                                         FontWeight="Bold" FontSize="12" Padding="6,3" Height="26" VerticalContentAlignment="Center"
                                         ToolTip="고객 전화번호 (숫자 입력 시 자동 하이픈)" />
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- ROW 2: AUTOMATIC CUSTOMER MATCH HINT BANNER (매칭 시에만 노출) -->
                    <Border Grid.Row="2" Visibility="{Binding HasExistingCustomerMatch, Converter={StaticResource BoolToVis}}" 
                            Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,6">
                        <DockPanel>
                            <TextBlock Text="{Binding ExistingMatchMessage}" FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0">
                                <Button Content="기존정보 채우기" Command="{Binding FillExistingCustomerCommand}" Style="{StaticResource ModernButton}" 
                                        Background="#2563EB" FontSize="10" Padding="6,2" Margin="0,0,4,0" ToolTip="기존 고객 정보를 자동으로 채웁니다." />
                                <Button Content="이력 보기" Command="{Binding FilterHistoryForMatchedCustomerCommand}" Style="{StaticResource OutlineButton}" 
                                        FontSize="10" Padding="6,2" ToolTip="과거 상담 내역을 조회합니다." />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- ROW 3: ULTRA-SLIM METADATA & QUICK FOLLOW-UP BAR (초슬림 1줄 가로 배치) -->
                    <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Category -->
                                <ColumnDefinition Width="120" />
                                <!-- Status -->
                                <ColumnDefinition Width="105" />
                                <!-- Priority -->
                                <ColumnDefinition Width="95" />
                                <!-- Consultation Date -->
                                <ColumnDefinition Width="135" />
                                <!-- Follow-Up Date & Fast Presets -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Category -->
                            <DockPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="구분" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,3,0" />
                                <ComboBox ItemsSource="{Binding EditCategories}" SelectedItem="{Binding EditRecord.Category}" Padding="4,2" FontSize="11" Height="24" VerticalContentAlignment="Center" />
                            </DockPanel>

                            <!-- Status -->
                            <DockPanel Grid.Column="1" Margin="0,0,6,0">
                                <TextBlock Text="상태" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,3,0" />
                                <ComboBox ItemsSource="{Binding EditStatuses}" SelectedItem="{Binding EditRecord.Status}" Padding="4,2" FontSize="11" Height="24" VerticalContentAlignment="Center" />
                            </DockPanel>

                            <!-- Priority -->
                            <DockPanel Grid.Column="2" Margin="0,0,6,0">
                                <TextBlock Text="중요도" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,3,0" />
                                <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding EditRecord.Priority}" Padding="4,2" FontSize="11" Height="24" VerticalContentAlignment="Center" />
                            </DockPanel>

                            <!-- Consultation Date -->
                            <DockPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="일시" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,3,0" />
                                <DatePicker SelectedDate="{Binding EditRecord.ConsultationDate}" Padding="3,1" FontSize="11" Height="24" />
                            </DockPanel>

                            <!-- Follow-Up Date & Fast Presets -->
                            <DockPanel Grid.Column="4">
                                <TextBlock Text="재상담" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,3,0" />
                                
                                <!-- Fast Preset Mini Buttons (Dock Right) -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <Button Content="오늘" Command="{Binding SetFollowUpDaysCommand}" CommandParameter="0" 
                                            Style="{StaticResource MiniToolButton}" Padding="4,2" Margin="0,0,2,0" ToolTip="오늘" />
                                    <Button Content="+1일" Command="{Binding SetFollowUpDaysCommand}" CommandParameter="1" 
                                            Style="{StaticResource MiniToolButton}" Padding="4,2" Margin="0,0,2,0" ToolTip="내일" />
                                    <Button Content="+3일" Command="{Binding SetFollowUpDaysCommand}" CommandParameter="3" 
                                            Style="{StaticResource MiniToolButton}" Padding="4,2" Margin="0,0,2,0" ToolTip="3일 후" />
                                    <Button Content="+7일" Command="{Binding SetFollowUpDaysCommand}" CommandParameter="7" 
                                            Style="{StaticResource MiniToolButton}" Padding="4,2" Margin="0,0,2,0" ToolTip="1주일 후" />
                                    <Button Content="✕" Command="{Binding SetFollowUpDaysCommand}" CommandParameter="-1" 
                                            Style="{StaticResource MiniToolButton}" Foreground="{StaticResource DangerBrush}" Padding="4,2" ToolTip="재상담 해제" />
                                </StackPanel>

                                <DatePicker SelectedDate="{Binding EditRecord.FollowUpDate}" Padding="3,1" FontSize="11" Height="24" />
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- ROW 4: SUMMARY & TAGS (1줄 가로 배치) -->
                    <Grid Grid.Row="4" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <!-- Summary -->
                            <ColumnDefinition Width="*" />
                            <!-- Tags -->
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>

                        <!-- Summary (Essential 1-line headline) -->
                        <DockPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="상담 요약*" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Text="{Binding EditRecord.Summary, UpdateSourceTrigger=PropertyChanged}" 
                                     FontSize="12" 
                                     Padding="6,3" Height="26" VerticalContentAlignment="Center" />
                        </DockPanel>

                        <!-- Tags (Optional) -->
                        <DockPanel Grid.Column="1">
                            <TextBlock Text="태그" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Text="{Binding EditRecord.Tags, UpdateSourceTrigger=PropertyChanged}" 
                                     FontSize="11" Padding="6,3" Height="26" VerticalContentAlignment="Center" ToolTip="예: #견적서, #긴급" />
                        </DockPanel>
                    </Grid>

                    <!-- ROW 5: DETAILS TOOLBAR (FONT SIZE ZOOM CONTROLS) - 높이 최소화 (~22px) -->
                    <DockPanel Grid.Row="5" Margin="0,2,0,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📝 상세 상담 내용" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="(주요 대화 및 고객 요청사항 기록)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>

                        <!-- Font Size Zoom Toolbar -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="글자 크기:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <Button Content="A-" Command="{Binding DecreaseFontSizeCommand}" Style="{StaticResource OutlineButton}" 
                                    Padding="4,0" Height="20" MinWidth="22" FontSize="9" ToolTip="글자 크기 축소 (Ctrl + 마우스 휠 아래)" Margin="0,0,2,0" />
                            <ComboBox ItemsSource="{Binding AvailableFontSizes}" SelectedItem="{Binding WritingFontSize}" 
                                      ItemStringFormat="{}{0}pt" Width="54" Height="20" Padding="2,0" FontSize="10" VerticalContentAlignment="Center" ToolTip="글자 크기 선택" Margin="0,0,2,0" />
                            <Button Content="A+" Command="{Binding IncreaseFontSizeCommand}" Style="{StaticResource OutlineButton}" 
                                    Padding="4,0" Height="20" MinWidth="22" FontSize="9" ToolTip="글자 크기 확대 (Ctrl + 마우스 휠 위)" Margin="0,0,2,0" />
                            <Button Content="기본" Command="{Binding ResetFontSizeCommand}" Style="{StaticResource OutlineButton}" 
                                    Padding="4,0" Height="20" FontSize="9" ToolTip="기본 크기(14pt)로 재설정" Margin="0,0,6,0" />
                            <TextBlock Text="(Ctrl+휠 줌 가능)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>

                    <!-- ROW 6: DETAILS TEXTAREA (상단부터 타이핑 시작하도록 VerticalContentAlignment=Top 설정) -->
                    <TextBox Grid.Row="6" 
                             x:Name="DetailsTextBox"
                             Text="{Binding EditRecord.Details, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="{Binding WritingFontSize}"
                             PreviewMouseWheel="OnWritingTextBoxPreviewMouseWheel"
                             TextWrapping="Wrap" 
                             AcceptsReturn="True" 
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" 
                             HorizontalScrollBarVisibility="Disabled"
                             Padding="12,10"
                             Margin="0,0,0,8"
                             Background="White"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1" />

                    <!-- ROW 7: ATTACHED IMAGES & THUMBNAIL GALLERY (그림/사진 첨부 및 크기 조절) -->
                    <Border Grid.Row="7" Margin="0,0,0,8" Padding="10,6" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <!-- Header Toolbar -->
                            <DockPanel Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📷" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding AttachedImagesCountText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="(더블클릭: 확대 보기  |  드래그/붙여넣기: 추가)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Thumbnail Size Control (Visible when images exist) -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                                                Visibility="{Binding HasAttachedImages, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="썸네일 크기:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <Button Content="-" Command="{Binding DecreaseThumbnailSizeCommand}" Style="{StaticResource OutlineButton}"
                                                Padding="4,0" Height="20" MinWidth="18" FontSize="9" Margin="0,0,2,0" ToolTip="썸네일 축소" />
                                        <Slider Minimum="50" Maximum="240" Value="{Binding ImageThumbnailSize}" Width="75" VerticalAlignment="Center"
                                                SmallChange="10" LargeChange="20" ToolTip="썸네일 크기 직접 조절" Margin="2,0,2,0" />
                                        <Button Content="+" Command="{Binding IncreaseThumbnailSizeCommand}" Style="{StaticResource OutlineButton}"
                                                Padding="4,0" Height="20" MinWidth="18" FontSize="9" Margin="0,0,2,0" ToolTip="썸네일 확대" />
                                        <Button Content="기본" Command="{Binding ResetThumbnailSizeCommand}" Style="{StaticResource OutlineButton}"
                                                Padding="4,0" Height="20" FontSize="9" Margin="0,0,6,0" ToolTip="기본 크기(85px)로 재설정" />
                                    </StackPanel>

                                    <!-- Add Image Button -->
                                    <Button Content="+ 사진 추가" Command="{Binding AddImageCommand}" Style="{StaticResource OutlineButton}" 
                                            FontSize="10" Padding="8,2" Height="22" Margin="0,0,4,0" ToolTip="이미지 파일 선택 (JPG, PNG, BMP, GIF, WEBP 등 다중 선택 가능)" />

                                    <!-- Paste Image Button -->
                                    <Button Content="📋 붙여넣기" Command="{Binding PasteImageCommand}" Style="{StaticResource OutlineButton}" 
                                            FontSize="10" Padding="8,2" Height="22" ToolTip="클립보드에 복사된 캡처화면이나 이미지 붙여넣기 (Ctrl + V)" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Drop Hint Area when no images attached -->
                            <Border Margin="0,4,0,2" Padding="0,9" Background="White" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6"
                                    Visibility="{Binding HasAttachedImages, Converter={StaticResource InverseBoolToVis}}"
                                    Cursor="Hand" ToolTip="클릭하여 사진 파일 추가, 또는 파일을 마우스로 끌어다 놓으세요">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding AddImageCommand}" />
                                </Border.InputBindings>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="📥" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="사진/그림 파일을 이곳에 끌어다 놓으세요 (드래그 앤 드롭)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="또는 클릭하여 사진 추가 / Ctrl+V 붙여넣기" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Horizontal Gallery ScrollViewer -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          Visibility="{Binding HasAttachedImages, Converter={StaticResource BoolToVis}}"
                                          MaxHeight="260" Margin="0,2,0,2">
                                <ItemsControl ItemsSource="{Binding AttachedImages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,8,0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                                    Width="{Binding DataContext.ImageThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Height="{Binding DataContext.ImageThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ClipToBounds="True" Cursor="Hand" ToolTip="더블 클릭하여 큰 화면으로 확대 보기">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftDoubleClick" 
                                                                  Command="{Binding DataContext.OpenImageViewerCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                  CommandParameter="{Binding}" />
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Image Source="{Binding Converter={StaticResource ImagePathToBitmap}, ConverterParameter=300}" 
                                                           Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    
                                                    <!-- Top overlay bar for buttons -->
                                                    <Border VerticalAlignment="Top" Height="24" Background="#77000000">
                                                        <DockPanel Margin="3,2,3,0">
                                                            <Button DockPanel.Dock="Left" Content="🔍" 
                                                                    Command="{Binding DataContext.OpenImageViewerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Width="20" Height="20" Padding="0" FontSize="9" Background="#55FFFFFF" Foreground="White" BorderThickness="0"
                                                                    Cursor="Hand" ToolTip="사진 크게 보기 (더블클릭 가능)" />
                                                            <Button DockPanel.Dock="Right" Content="✕" 
                                                                    Command="{Binding DataContext.RemoveImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Width="20" Height="20" Padding="0" FontSize="11" FontWeight="Bold" Background="#D0EF4444" Foreground="White" BorderThickness="0"
                                                                    Cursor="Hand" ToolTip="사진 첨부 취소" />
                                                        </DockPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- ROW 8: BOTTOM ACTION BAR (단정하고 깔끔한 액션 툴바) -->
                    <Grid Grid.Row="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Main Save Button -->
                        <Button Grid.Column="0" Content="💾 상담 내용 저장하기 (Ctrl + S)" Command="{Binding SaveRecordCommand}" 
                                Style="{StaticResource ModernButton}" FontSize="13" Padding="0,8" Margin="0,0,6,0" />

                        <!-- Copy Entire Summary Button (for Messengers/ERP) -->
                        <Button Grid.Column="1" Content="📋 상담 내용 전체 복사" Command="{Binding CopyAllSummaryCommand}" 
                                Style="{StaticResource OutlineButton}" FontSize="11" Padding="12,8" Margin="0,0,6,0" 
                                ToolTip="상담 요약 및 상세 내용을 메신저/ERP 공유용 텍스트로 복사합니다." />

                        <!-- Delete Button -->
                        <Button Grid.Column="2" Content="🗑 삭제" Command="{Binding DeleteRecordCommand}" 
                                Style="{StaticResource DangerButton}" FontSize="11" Padding="12,8" 
                                ToolTip="현재 상담 기록을 영구 삭제합니다." />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- BOTTOM STATUS BAR & SHORTCUT HELP GUIDE   -->
        <!-- ========================================== -->
        <StatusBar Grid.Row="2" Background="Transparent" Margin="0,4,0,0" Padding="0">
            <StatusBarItem HorizontalAlignment="Left">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="단축키: [Ctrl+S] 저장  |  [Ctrl+N] 신규  |  [Ctrl+F] 검색  |  [F11] 목록접기/펼치기  |  [Ctrl+휠] 글자크기" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
            </StatusBarItem>
        </StatusBar>

        <!-- ============================================================== -->
        <!-- FULL-SCREEN MODAL IMAGE VIEWER OVERLAY                         -->
        <!-- ============================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="#E60F172A"
              Visibility="{Binding IsImageViewerOpen, Converter={StaticResource BoolToVis}}"
              PreviewMouseWheel="OnImageViewerPreviewMouseWheel">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <!-- Top Controls Toolbar -->
                    <RowDefinition Height="Auto" />
                    <!-- Centered Zoomable Image Area -->
                    <RowDefinition Height="*" />
                    <!-- Bottom Helper Note -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Controls Toolbar -->
                <Border Grid.Row="0" Background="#F21E293B" CornerRadius="8" Padding="16,10" Margin="0,0,0,12">
                    <DockPanel>
                        <!-- Title & File Name -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📷 사진 상세 확대 보기" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ViewingImageFileName}" FontSize="12" Foreground="#94A3B8" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Zoom Controls & Close Button -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="확대 비율:" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0" />
                            
                            <Button Content="-" Command="{Binding ZoomOutViewerCommand}" 
                                    Style="{StaticResource OutlineButton}" Foreground="White" BorderBrush="#64748B" Background="#334155"
                                    Width="28" Height="26" FontSize="13" FontWeight="Bold" ToolTip="축소 (마우스 휠 아래)" Margin="0,0,4,0" />
                            
                            <Border Background="#0F172A" CornerRadius="4" Padding="10,3" VerticalAlignment="Center" Margin="0,0,4,0">
                                <TextBlock Text="{Binding ViewerZoomPercentage}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" Width="44" TextAlignment="Center" />
                            </Border>
                            
                            <Button Content="+" Command="{Binding ZoomInViewerCommand}" 
                                    Style="{StaticResource OutlineButton}" Foreground="White" BorderBrush="#64748B" Background="#334155"
                                    Width="28" Height="26" FontSize="13" FontWeight="Bold" ToolTip="확대 (마우스 휠 위)" Margin="0,0,4,0" />
                            
                            <Button Content="100% 원본" Command="{Binding ResetViewerZoomCommand}" 
                                    Style="{StaticResource OutlineButton}" Foreground="White" BorderBrush="#64748B" Background="#334155"
                                    Padding="10,0" Height="26" FontSize="11" ToolTip="기본 100% 크기로 재설정" Margin="0,0,16,0" />

                            <!-- Close Button -->
                            <Button Content="✕ 닫기 (ESC)" Command="{Binding CloseImageViewerCommand}" 
                                    Style="{StaticResource DangerButton}" Padding="16,4" Height="28" FontSize="12" FontWeight="Bold"
                                    ToolTip="뷰어 닫기 (ESC 키)" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Zoomable Image Viewport with ScrollViewer -->
                <Border Grid.Row="1" Background="#090D16" CornerRadius="8" ClipToBounds="True" BorderBrush="#334155" BorderThickness="1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="16">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="{Binding ViewingImagePath, Converter={StaticResource ImagePathToBitmap}}" 
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding ViewerZoomFactor}" ScaleY="{Binding ViewerZoomFactor}" />
                                </Image.LayoutTransform>
                            </Image>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- Bottom Guidance Bar -->
                <Border Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock Text="💡 마우스 휠을 굴려 확대/축소할 수 있으며, ESC 키 또는 우측 상단 [✕ 닫기] 버튼을 누르면 이전 화면으로 돌아갑니다." 
                               FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
