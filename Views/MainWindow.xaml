<Window x:Class="ConsultationLedger.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:ConsultationLedger.ViewModels"
        mc:Ignorable="d"
        Title="ConsultationHub - 스마트 고객 상담 관리 장부" 
        Icon="../app_icon.ico"
        Height="870" Width="1440"
        MinHeight="720" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveRecordCommand}" />
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewRecordCommand}" />
        <KeyBinding Modifiers="Control" Key="F" Command="{Binding ClearSearchCommand}" />
    </Window.InputBindings>

    <Grid Margin="18,14,18,12">
        <Grid.RowDefinitions>
            <!-- Row 0: Brand Header & KPI Dashboard -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Main Two-Column Workspace (Master-Detail) -->
            <RowDefinition Height="*" />
            <!-- Row 2: Status Bar & Shortcut Guide -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- TOP HEADER: BRANDING & KPI DASHBOARD BAR   -->
        <!-- ========================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- App Logo & Title -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" Background="{StaticResource PrimaryBrush}" CornerRadius="10" Margin="0,0,10,0">
                        <TextBlock Text="📋" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Consultation" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Hub" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="스마트 고객 상담 관리 장부" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- KPI Metric Cards (4 Compact Cards) -->
            <Grid Grid.Column="1" Margin="12,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Today Consultations -->
                <Border Grid.Column="0" Style="{StaticResource KpiCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="오늘 진행 상담" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="{Binding TodayCount}" Style="{StaticResource KpiValueText}" />
                                <TextBlock Text=" 건" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="3,0,0,3" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="📅" FontSize="20" VerticalAlignment="Center" Opacity="0.8" />
                    </Grid>
                </Border>

                <!-- Month Total -->
                <Border Grid.Column="1" Style="{StaticResource KpiCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="이번 달 총 상담" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="{Binding MonthCount}" Style="{StaticResource KpiValueText}" Foreground="{StaticResource InfoBrush}" />
                                <TextBlock Text=" 건" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="3,0,0,3" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="📊" FontSize="20" VerticalAlignment="Center" Opacity="0.8" />
                    </Grid>
                </Border>

                <!-- Pending Follow-ups -->
                <Border Grid.Column="2" Style="{StaticResource KpiCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="재상담/팔로우업 예정" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="{Binding PendingFollowUpCount}" Style="{StaticResource KpiValueText}" Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Text=" 건" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="3,0,0,3" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="⏰" FontSize="20" VerticalAlignment="Center" Opacity="0.8" />
                    </Grid>
                </Border>

                <!-- Total Count -->
                <Border Grid.Column="3" Style="{StaticResource KpiCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="누적 보관 데이터" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="{Binding TotalCount}" Style="{StaticResource KpiValueText}" Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock Text=" 건" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="3,0,0,3" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="📁" FontSize="20" VerticalAlignment="Center" Opacity="0.8" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Top Right Action Toolbar -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="📊 엑셀(CSV) 내보내기" Command="{Binding ExportCsvCommand}" Style="{StaticResource OutlineButton}" Padding="12,8" Margin="0,0,6,0" ToolTip="현재 목록을 엑셀 호환 CSV 파일로 저장합니다." />
                <Button Content="🔄 새로고침" Command="{Binding SearchCommand}" Style="{StaticResource OutlineButton}" Padding="10,8" ToolTip="목록과 통계를 새로고침합니다 (F5)" />
            </StackPanel>
        </Grid>

        <!-- ============================================================== -->
        <!-- MAIN TWO-COLUMN SPLIT WORKSPACE (MASTER - DETAIL)              -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left: Master Consultation List & Smart Filter (550px) -->
                <ColumnDefinition Width="550" MinWidth="450" />
                <!-- Center Divider Margin -->
                <ColumnDefinition Width="14" />
                <!-- Right: Consultation Detail & Smart Editor (Flex *) -->
                <ColumnDefinition Width="*" MinWidth="580" />
            </Grid.ColumnDefinitions>

            <!-- ============================================== -->
            <!-- LEFT COLUMN: MASTER CONSULTATION LIST PANE     -->
            <!-- ============================================== -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Row 0: Search Input Box -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Quick Filter Chips Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Sub-filter & Record Count Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 3: Modern DataGrid List -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search Input Box (with Clear button) -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" 
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="30,8,8,8" 
                                 FontSize="13" 
                                 ToolTip="단축키: Ctrl + F (고객명, 연락처, 주소, 내용, 태그 통합 검색)" />
                        <!-- Magnifier Icon Overlay -->
                        <TextBlock Text="🔍" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" 
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
                        <!-- Clear Search Button -->
                        <Button Grid.Column="1" Content="✕" Command="{Binding ClearSearchCommand}" 
                                Style="{StaticResource OutlineButton}" Width="32" Height="34" Margin="6,0,0,0" 
                                Padding="0" ToolTip="검색어 지우기" />
                    </Grid>

                    <!-- Quick Filter Chips Bar (원클릭 필터 칩) -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <!-- All -->
                            <Button Content="전체" Command="{Binding SetQuickFilterCommand}" CommandParameter="전체" 
                                    Margin="0,0,4,0" Padding="12,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Today -->
                            <Button Content="오늘 상담" Command="{Binding SetQuickFilterCommand}" CommandParameter="오늘" 
                                    Margin="0,0,4,0" Padding="12,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterToday}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- In Progress -->
                            <Button Content="진행중" Command="{Binding SetQuickFilterCommand}" CommandParameter="진행중" 
                                    Margin="0,0,4,0" Padding="12,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterProgress}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Follow-up Needed -->
                            <Button Content="재상담 예정" Command="{Binding SetQuickFilterCommand}" CommandParameter="재상담 예정" 
                                    Margin="0,0,4,0" Padding="12,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterFollowUp}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Completed -->
                            <Button Content="완료" Command="{Binding SetQuickFilterCommand}" CommandParameter="완료" 
                                    Margin="0,0,4,0" Padding="12,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterCompleted}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Urgent -->
                            <Button Content="긴급" Command="{Binding SetQuickFilterCommand}" CommandParameter="긴급" 
                                    Margin="0,0,0,0" Padding="12,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterUrgent}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sub-filter Toolbar (Category Dropdown + Count Indicator) -->
                    <DockPanel Grid.Row="2" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="카테고리:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategoryFilter}" 
                                      FontSize="11" Padding="6,3" Height="26" VerticalContentAlignment="Center" Width="105" Margin="0,0,8,0" />
                            <Button Content="초기화" Command="{Binding ResetFilterCommand}" Style="{StaticResource OutlineButton}" 
                                    FontSize="10" Padding="6,2" Height="26" ToolTip="모든 검색어 및 필터 조건을 초기화합니다." />
                        </StackPanel>

                        <!-- Count Badge -->
                        <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}">
                                <Run Text="조회 " /><Run Text="{Binding Records.Count, Mode=OneWay}" /><Run Text="건" />
                            </TextBlock>
                        </Border>
                    </DockPanel>

                    <!-- Modern DataGrid List -->
                    <DataGrid Grid.Row="3" 
                              ItemsSource="{Binding Records}" 
                              SelectedItem="{Binding SelectedRecord}"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              HeadersVisibility="Column"
                              RowHeight="44">
                        <DataGrid.Columns>
                            <!-- Index Column -->
                            <DataGridTextColumn Header="No" Binding="{Binding RowIndex}" Width="36">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter Property="FontSize" Value="11" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Modern Status Pill Badge -->
                            <DataGridTemplateColumn Header="상태" Width="68">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBgColor}" CornerRadius="11" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusFgColor}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Customer Name -->
                            <DataGridTextColumn Header="고객명" Binding="{Binding DisplayClientName}" Width="75">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Phone -->
                            <DataGridTextColumn Header="연락처" Binding="{Binding ClientPhone}" Width="105">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontSize" Value="12" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Date (MM-dd HH:mm) -->
                            <DataGridTextColumn Header="일시" Binding="{Binding ShortDate}" Width="82">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontSize" Value="11" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Summary -->
                            <DataGridTextColumn Header="상담 요약" Binding="{Binding Summary}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ================================================= -->
            <!-- RIGHT COLUMN: DETAIL & SMART EDITOR CANVASPANE    -->
            <!-- ================================================= -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Row 0: Canvas Header (Mode Indicator + New Record Button) -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Smart Customer Profile Card -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Metadata & Quick Follow-Up Presets -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 3: Summary & Tags -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 4: Details Toolbar (Font Size Controls) -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 5: Details TextArea (Fills remaining height) -->
                        <RowDefinition Height="*" />
                        <!-- Row 6: Prominent Bottom Action Bar -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Canvas Header (Mode Title + Fast New Button) -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EditModeTitle}" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
                            <Border Visibility="{Binding IsEditingNew, Converter={StaticResource BoolToVis}}" 
                                    Background="{StaticResource PrimarySoftBrush}" CornerRadius="6" Padding="6,2" Margin="8,0,0,0">
                                <TextBlock Text="신규" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                            </Border>
                        </StackPanel>

                        <!-- Fast New Record Button -->
                        <Button Content="+ 새 상담 작성 (Ctrl+N)" Command="{Binding NewRecordCommand}" Style="{StaticResource OutlineButton}" 
                                HorizontalAlignment="Right" Padding="12,5" FontWeight="SemiBold" ToolTip="현재 입력을 초기화하고 새로운 상담 작성 모드로 전환합니다." />
                    </DockPanel>

                    <!-- ===================================================== -->
                    <!-- SECTION 1: SMART CUSTOMER PROFILE CARD                -->
                    <!-- ===================================================== -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Card Section Label -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="👤 고객 인적사항" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="* 표시는 필수 항목입니다" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- 3 Columns Input Grid: Phone*, Name, Address* -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" /> <!-- Phone* -->
                                    <ColumnDefinition Width="130" /> <!-- Name -->
                                    <ColumnDefinition Width="*" />   <!-- Address* -->
                                </Grid.ColumnDefinitions>

                                <!-- Phone Field with Quick Copy -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock Text="연락처 (전화번호) *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <Button Content="복사" Command="{Binding CopyPhoneCommand}" Style="{StaticResource MiniToolButton}" 
                                                HorizontalAlignment="Right" ToolTip="전화번호를 클립보드에 복사합니다." />
                                    </DockPanel>
                                    <TextBox x:Name="PhoneTextBox" 
                                             Text="{Binding EditRecord.ClientPhone, UpdateSourceTrigger=PropertyChanged}" 
                                             TextChanged="OnCustomerInfoInputChanged" 
                                             LostFocus="OnPhoneTextBoxLostFocus"
                                             FontWeight="Bold" FontSize="13" Padding="8,5" />
                                </StackPanel>

                                <!-- Customer Name Field -->
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="고객명 (선택)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding EditRecord.ClientName, UpdateSourceTrigger=PropertyChanged}" 
                                             TextChanged="OnCustomerInfoInputChanged" 
                                             FontSize="13" Padding="8,5" />
                                </StackPanel>

                                <!-- Address Field with Quick Copy -->
                                <StackPanel Grid.Column="2">
                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock Text="주소 (소재지/배송지) *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <Button Content="복사" Command="{Binding CopyAddressCommand}" Style="{StaticResource MiniToolButton}" 
                                                HorizontalAlignment="Right" ToolTip="주소를 클립보드에 복사합니다." />
                                    </DockPanel>
                                    <TextBox Text="{Binding EditRecord.Address, UpdateSourceTrigger=PropertyChanged}" 
                                             TextChanged="OnCustomerInfoInputChanged" 
                                             FontWeight="Bold" FontSize="13" Padding="8,5" />
                                </StackPanel>
                            </Grid>

                            <!-- AUTOMATIC CUSTOMER MATCH HINT BANNER -->
                            <Border Visibility="{Binding HasExistingCustomerMatch, Converter={StaticResource BoolToVis}}" 
                                    Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,8,0,0">
                                <DockPanel>
                                    <TextBlock Text="{Binding ExistingMatchMessage}" FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Button Content="기존정보 채우기" Command="{Binding FillExistingCustomerCommand}" Style="{StaticResource ModernButton}" 
                                                Background="#2563EB" FontSize="11" Padding="8,3" Margin="0,0,4,0" ToolTip="일치하는 고객의 이름, 연락처, 주소를 현재 폼에 자동으로 채웁니다." />
                                        <Button Content="이력 보기" Command="{Binding FilterHistoryForMatchedCustomerCommand}" Style="{StaticResource OutlineButton}" 
                                                FontSize="11" Padding="8,3" ToolTip="이 고객의 과거 모든 상담 내역을 왼쪽 목록에서 조회합니다." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ===================================================== -->
                    <!-- SECTION 2: METADATA & QUICK FOLLOW-UP PRESETS         -->
                    <!-- ===================================================== -->
                    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 1: Category, Status, Priority, Consultation Date -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.3*" />
                                </Grid.ColumnDefinitions>

                                <!-- Category -->
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="카테고리" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                    <ComboBox ItemsSource="{Binding EditCategories}" SelectedItem="{Binding EditRecord.Category}" Padding="6,4" FontSize="12" />
                                </StackPanel>

                                <!-- Status -->
                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock Text="진행 상태" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                    <ComboBox ItemsSource="{Binding EditStatuses}" SelectedItem="{Binding EditRecord.Status}" Padding="6,4" FontSize="12" />
                                </StackPanel>

                                <!-- Priority -->
                                <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                    <TextBlock Text="우선순위" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                    <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding EditRecord.Priority}" Padding="6,4" FontSize="12" />
                                </StackPanel>

                                <!-- Consultation Date -->
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="상담 일시" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                    <DatePicker SelectedDate="{Binding EditRecord.ConsultationDate}" Padding="6,3" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Follow-Up Date with Fast Preset Chips -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="재상담 예정일 (선택)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                    <DatePicker SelectedDate="{Binding EditRecord.FollowUpDate}" Padding="6,3" FontSize="12" />
                                </StackPanel>

                                <!-- Fast Follow-Up Date Preset Chips -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,1">
                                    <TextBlock Text="빠른 날짜 지정:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="오늘" Command="{Binding SetFollowUpDaysCommand}" CommandParameter="0" 
                                                Style="{StaticResource MiniToolButton}" Margin="0,0,3,0" ToolTip="오늘을 재상담일로 설정합니다." />
                                        <Button Content="+1일 (내일)" Command="{Binding SetFollowUpDaysCommand}" CommandParameter="1" 
                                                Style="{StaticResource MiniToolButton}" Margin="0,0,3,0" ToolTip="내일을 재상담일로 설정합니다." />
                                        <Button Content="+3일" Command="{Binding SetFollowUpDaysCommand}" CommandParameter="3" 
                                                Style="{StaticResource MiniToolButton}" Margin="0,0,3,0" ToolTip="3일 후를 재상담일로 설정합니다." />
                                        <Button Content="+7일 (1주)" Command="{Binding SetFollowUpDaysCommand}" CommandParameter="7" 
                                                Style="{StaticResource MiniToolButton}" Margin="0,0,3,0" ToolTip="1주일 후를 재상담일로 설정합니다." />
                                        <Button Content="지우기" Command="{Binding SetFollowUpDaysCommand}" CommandParameter="-1" 
                                                Style="{StaticResource MiniToolButton}" Foreground="{StaticResource DangerBrush}" ToolTip="재상담 일정을 비웁니다." />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ===================================================== -->
                    <!-- SECTION 3: SUMMARY & TAGS ROW                         -->
                    <!-- ===================================================== -->
                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Summary (Essential 1-line headline) -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="상담 요약 (한 줄 정리) *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                            <TextBox Text="{Binding EditRecord.Summary, UpdateSourceTrigger=PropertyChanged}" 
                                     FontSize="{Binding WritingFontSize}" 
                                     PreviewMouseWheel="OnWritingTextBoxPreviewMouseWheel" 
                                     Padding="8,5" />
                        </StackPanel>

                        <!-- Tags (Optional) -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="태그 (#구분, 선택)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <TextBox Text="{Binding EditRecord.Tags, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="8,5" ToolTip="예: #견적서, #긴급, #신규" />
                        </StackPanel>
                    </Grid>

                    <!-- ===================================================== -->
                    <!-- SECTION 4: DETAILS TOOLBAR (FONT SIZE ZOOM CONTROLS)  -->
                    <!-- ===================================================== -->
                    <DockPanel Grid.Row="4" Margin="0,0,0,4">
                        <TextBlock Text="상세 상담 내용" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />

                        <!-- Font Size Toolbar -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="글자 크기:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Content="A-" Command="{Binding DecreaseFontSizeCommand}" Style="{StaticResource OutlineButton}" 
                                    Padding="6,1" Height="22" MinWidth="26" FontSize="10" ToolTip="글자 크기 축소 (Ctrl + 마우스 휠 아래)" Margin="0,0,2,0" />
                            <ComboBox ItemsSource="{Binding AvailableFontSizes}" SelectedItem="{Binding WritingFontSize}" 
                                      ItemStringFormat="{}{0}pt" Width="60" Height="22" Padding="4,0" FontSize="11" VerticalContentAlignment="Center" ToolTip="글자 크기 선택" Margin="0,0,2,0" />
                            <Button Content="A+" Command="{Binding IncreaseFontSizeCommand}" Style="{StaticResource OutlineButton}" 
                                    Padding="6,1" Height="22" MinWidth="26" FontSize="10" ToolTip="글자 크기 확대 (Ctrl + 마우스 휠 위)" Margin="0,0,2,0" />
                            <Button Content="기본" Command="{Binding ResetFontSizeCommand}" Style="{StaticResource OutlineButton}" 
                                    Padding="6,1" Height="22" FontSize="10" ToolTip="기본 크기(14pt)로 재설정" />
                        </StackPanel>
                    </DockPanel>

                    <!-- ===================================================== -->
                    <!-- SECTION 5: DETAILS TEXTAREA (EXPANDS TO FILL HEIGHT)   -->
                    <!-- ===================================================== -->
                    <TextBox Grid.Row="5" 
                             x:Name="DetailsTextBox"
                             Text="{Binding EditRecord.Details, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="{Binding WritingFontSize}"
                             PreviewMouseWheel="OnWritingTextBoxPreviewMouseWheel"
                             TextWrapping="Wrap" 
                             AcceptsReturn="True" 
                             VerticalScrollBarVisibility="Auto" 
                             MinHeight="80"
                             Padding="10,8"
                             Margin="0,0,0,12" />

                    <!-- ===================================================== -->
                    <!-- SECTION 6: PROMINENT BOTTOM ACTION BAR                -->
                    <!-- ===================================================== -->
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Main Save Button (Prominent & Clear) -->
                        <Button Grid.Column="0" Content="💾 상담 내용 저장하기 (Ctrl + S)" Command="{Binding SaveRecordCommand}" 
                                Style="{StaticResource ModernButton}" FontSize="14" Padding="0,10" Margin="0,0,8,0" />

                        <!-- Copy Entire Summary Button (for Messengers/ERP) -->
                        <Button Grid.Column="1" Content="📋 내용 복사" Command="{Binding CopyAllSummaryCommand}" 
                                Style="{StaticResource OutlineButton}" FontSize="12" Padding="12,10" Margin="0,0,8,0" 
                                ToolTip="상담 요약 및 상세 내용을 메신저/ERP 공유용 텍스트로 복사합니다." />

                        <!-- Delete Button -->
                        <Button Grid.Column="2" Content="🗑 삭제" Command="{Binding DeleteRecordCommand}" 
                                Style="{StaticResource DangerButton}" FontSize="12" Padding="14,10" 
                                ToolTip="현재 상담 기록을 영구 삭제합니다." />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- BOTTOM STATUS BAR & SHORTCUT HELP GUIDE   -->
        <!-- ========================================== -->
        <StatusBar Grid.Row="2" Background="Transparent" Margin="0,8,0,0" Padding="0">
            <StatusBarItem HorizontalAlignment="Left">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="단축키 안내: [Ctrl+S] 저장  |  [Ctrl+N] 신규  |  [Ctrl+F] 검색어초기화  |  [Ctrl+마우스휠] 글자크기 줌" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
